{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluidrwa-backup",
  "main": "cloudflare-backup-worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "ratelimits": [{ "name": "FORM_RATE_LIMITER", "namespace_id": "2026100701", "simple": { "limit": 30, "period": 60 } }],
  "routes": [
    { "pattern": "fluidrwa.com/*", "zone_name": "fluidrwa.com" },
    { "pattern": "www.fluidrwa.com/*", "zone_name": "fluidrwa.com" }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "NETWORK_DB",
      "database_name": "fluidrwa-network-intelligence",
      "database_id": "7a7cee74-a2ab-425b-aaa1-e12eb6628968"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "fluidrwa-backup" }]
}
